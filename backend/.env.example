# Copy this file to .env and fill in your own values.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vioramusic

# JWT signing secret (use a long random string)
JWT_SECRET=change_me_to_a_long_random_string

# Server port
PORT=3000

# Gmail account used to send OTP emails (App Password, not the normal password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# OTP settings
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=45

# Spotify Web API credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
